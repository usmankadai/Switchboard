# Copy to .env.local and fill in what you need. Everything is optional.

# Sentry error monitoring. Leave empty to switch monitoring off (the default);
# the browser then downloads none of Sentry's code.
NEXT_PUBLIC_SENTRY_DSN=

# Absolute site URL, used when Client Components render on the server.
# On Vercel, NEXT_PUBLIC_VERCEL_URL is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Funnel dashboard storage (/funnel). Without these, counts are kept in the
# server's memory and reset on restart, which is not enough on serverless
# hosting. Any Redis with Upstash's REST API works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
